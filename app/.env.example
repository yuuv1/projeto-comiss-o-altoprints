# ------------------------------------------------------------------
# Banco de dados na nuvem (Supabase) — OPCIONAL
# ------------------------------------------------------------------
# Sem estas variáveis o sistema funciona em MODO LOCAL (os dados ficam
# salvos apenas no navegador deste computador/celular).
#
# Para usar na nuvem, crie um projeto gratuito em https://supabase.com,
# rode o arquivo supabase/schema.sql no "SQL Editor" e preencha abaixo
# com os valores que aparecem em Project Settings > API (ou no botão
# "Connect" do projeto).
#
# Depois renomeie este arquivo para ".env" e gere o pacote de novo:
#     cd app && npm run publicar
#
# ⚠️  O arquivo ".env" NUNCA vai para o Git (ele já está no .gitignore).
# ⚠️  Use sempre a chave PÚBLICA do projeto. A chave secreta
#     (sb_secret_... / service_role) dá acesso total ao banco e o sistema
#     se recusa a conectar com ela — de propósito.
# ------------------------------------------------------------------

VITE_SUPABASE_URL=

# Projetos novos: chave "publishable" (começa com sb_publishable_)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Projetos antigos: chave "anon" (começa com eyJ). Pode usar qualquer uma das duas.
VITE_SUPABASE_ANON_KEY=
